# bookgen — environment. Copy to .env and fill in; .env is gitignored and is
# never baked into the Docker image. On a server, pass it at run time:
#
#     docker run --rm --env-file .env ...
#
# Nothing here has a default that is a secret. The config vars below do have
# working defaults, shown in parentheses.

# ---------------------------------------------------------------- secrets

# Google AI Studio key, used by `gen` for every image request. A paid key is
# required; the free tier is not enough for a sweep. Read from the environment
# only — bookgen never reads a key file.
GEMINI_API_KEY=

# The aws CLI's own variables, used by `publish` and by the reference-photo
# fetch. Optional: the CLI falls back to ~/.aws/credentials on a laptop, and on
# a VPS the instance role supplies credentials with no keys at all, which is
# the intended setup there. Never put long-lived keys on the server.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-west-1

# ---------------------------------------------------------------- config

# S3 bucket `publish` uploads a book to. The bucket is world-readable, so
# anything under it is public the moment it lands. (default: bookgen-books)
BOOKGEN_BUCKET=bookgen-books

# Prefix holding the two reference-photo trees — real likenesses of real
# people, which are deliberately not in git. Synced into a temp dir for the
# length of one command and deleted afterwards, so the photos are never at rest
# on the server's disk. The prefix must contain `reference-photos/` and
# `reference-photos-cropped/` as its immediate children, which is exactly what
# uploading the two repo directories side by side produces.
#
# Unset means "use BOOKGEN_REF_PHOTOS_DIR", which defaults to the repo root —
# the local arrangement. Set at most one of the two.
# BOOKGEN_REF_PHOTOS_S3=s3://my-private-bucket/photo-refs

# A local directory holding those same two trees. Only needed when they are
# somewhere other than the repo root. Mutually exclusive with the S3 prefix.
# BOOKGEN_REF_PHOTOS_DIR=
