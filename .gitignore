# Generated by bookgen, per book: compiled prompts, runs, downscaled ref cache.
# Contents rather than the directory itself — git will not re-include a path
# whose parent directory is excluded, and picks.json has to come back below.
books/*/out/*

# NOT a build artifact. picks.json records which candidate was chosen for each
# slot and diagram; regenerating it means paying for and re-reviewing every
# candidate again. It is the one thing in out/ that is a decision, not output.
!books/*/out/picks.json

# The bucket-root index that `publish-index` builds before uploading it.
/out-index.html
__pycache__/
.DS_Store

# Real reference photos — people's likenesses. Not in git, on purpose.
# reference-photos/ holds one subdir per book slug; reference-photos-cropped/
# is what tools/crop-labeler.html cuts out of them. Both are inputs, both are
# private, and the pipeline reads them from BOOKGEN_REF_PHOTOS_S3 on a server.
#
# Excluded by contents rather than by directory, so the sample book's synthetic
# placeholders can come back below: git will not re-include a path whose parent
# directory is excluded.
/reference-photos/*
!/reference-photos/sample-book/
/reference-photos-cropped/

# Secrets. .env.example carries the variable names and nothing else.
.env

# The locked environment uv builds from pyproject.toml + uv.lock.
.venv/
